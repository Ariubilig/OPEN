# Copy to .env.local for local development (`supabase start` prints the key).
# On the static host, set the same variables for the production build.

# Supabase API URL and the public (publishable or anon) key. Never put the secret or
# service-role key in a VITE_ variable: everything VITE_ ends up in the browser.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Public origin of the site, without a trailing slash. Used at build time for canonical URLs,
# the sitemap and the RSS feed.
SITE_URL=http://localhost:5173
