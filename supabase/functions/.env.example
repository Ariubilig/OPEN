# Edge function secrets. Locally: copy to supabase/functions/.env (gitignored) and restart
# `supabase start`. In production: `supabase secrets set NAME=value` (never commit real values).

# AI draft (ai-draft). Without a key the admin shows "AI ноорог тохируулагдаагүй байна".
ANTHROPIC_API_KEY=
# optional: the model (default claude-opus-5-5) and effort: low | medium | high (default high)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=high

# Email alerts (send-emails). Without a key, emails go to the local inbox (Mailpit) or are skipped.
# RESEND_API_KEY=
# EMAIL_FROM=Тод <alerts@example.mn>
